{
    "name": "talkcontrol",
    "version": "0.4.1",
    "main": "index.js",
    "scripts": {
        "clean": "rm -rf .cache dist",
        "create-tunnels": "npx tsx src/environment/create-tunnels.js",
        "get-started": "npx tsx src/environment/get-started.js",
        "start": "npx npm-run-all --parallel create-tunnels tc-server tc-showcase start-controller-after-server when-controller-is-started",
        "start-controller-after-server": "wait-on tcp:3001 && wait-on tcp:3002 && npm run tc-controller-and-component",
        "when-controller-is-started": "wait-on tcp:3000 && npm run get-started",
        "test": "npx mocha",
        "coverage": "npx c8 npm test",
        "coverage:check": "npx c8 check-coverage",
        "build": "npx webpack --config webpack.config.prod.cjs",
        "smoke:server": "npx tsx src/server/index.js",
        "lint": "eslint --fix . --cache",
        "commit": "npx git-cz",
        "tc-showcase": "npx http-server showcase -s -p 3002",
        "tc-controller-and-component": "npx webpack-dev-server --config webpack.config.dev.cjs",
        "tc-server": "npx nodemon --exec \"npx tsx\" src/server/index.js",
        "docs:dev": "vitepress dev docs-sources",
        "docs:build": "npm run jsdoc:build && vitepress build docs-sources --outDir ../docs-dist",
        "jsdoc:build": "node scripts/jsdoc-build.mjs",
        "test:e2e": "playwright test --config playwright.config.cjs",
        "test:e2e:report": "playwright show-report",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TalkControl/talk-control.git"
    },
    "contributors": [
        "Gildas Morel des Vallons <gildas2k@gmail.com>",
        "Jean-François Garreau <jean.francois.garreau@gmail.com>",
        "Julien Tanguy <julien.tanguy@jhome.fr>",
        "Tristan Elain <elain.t@sfeir.com>",
        "Nicolò <nicosh>",
        "Karthik Shetty <karthikshetty03>",
        "Luis Contreras <devrasec>"
    ],
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/TalkControl/TalkControl/issues"
    },
    "homepage": "https://github.com/TalkControl/TalkControl#readme",
    "devDependencies": {
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^8.3.4",
        "@granite-elements/granite-lit-bulma": "^0.9.0-4",
        "@playwright/test": "^1.61.0",
        "@vue/component-compiler-utils": "^3.1.2",
        "c8": "^11.0.0",
        "chai": "^6.2.2",
        "clean-webpack-plugin": "^3.0.0",
        "commitizen": "^4.2.1",
        "css-loader": "^7.1.2",
        "cz-conventional-changelog": "^3.2.0",
        "@eslint/js": "^9.39.4",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-jsdoc": "^63.0.7",
        "eslint-plugin-mocha": "^11.3.0",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^15.15.0",
        "html-webpack-plugin": "^5.6.7",
        "husky": "^9.1.7",
        "jsdoc-to-markdown": "^9.1.3",
        "jsdom": "^29.1.1",
        "jsdom-global": "3.0.2",
        "lit-element": "^4.2.2",
        "lit-fontawesome": "0.1.3",
        "mini-css-extract-plugin": "^2.9.2",
        "mocha": "^11.7.6",
        "nodemon": "^3.1.14",
        "nyc": "^15.1.0",
        "prettier": "^3.8.4",
        "pretty-quick": "^4.2.2",
        "redux-mock-store": "^1.5.5",
        "sinon": "^9.2.4",
        "supertest": "^6.3.4",
        "tsx": "^4.22.4",
        "url-loader": "^4.1.0",
        "vitepress": "^1.6.4",
        "webpack": "^5.107.2",
        "webpack-bundle-analyzer": "^3.9.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.5"
    },
    "directories": {
        "test": "test"
    },
    "nyc": {
        "include": [
            "test/**/*.js",
            "src/**/*.js"
        ],
        "reporter": [
            "text",
            "html"
        ],
        "all": true
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "dependencies": {
        "bulma": "^0.9.0",
        "colors": "^1.4.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "http-proxy": "^1.18.1",
        "http-server": "^0.12.3",
        "ngrok": "^3.4.1",
        "npm-run-all": "^4.1.5",
        "qrcode": "^1.5.4",
        "query-selector-shadow-dom": "^0.3.4",
        "redux": "^4.2.1",
        "redux-logger": "^3.0.6",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "wait-on": "^4.0.2"
    },
    "browserslist": [
        "defaults",
        "maintained node versions"
    ],
    "browser": {
        "socket.io": false
    },
    "nodemonConfig": {
        "ignore": [
            "dist/*",
            "test/*",
            "showcase/*",
            "src/client/*"
        ]
    }
}
